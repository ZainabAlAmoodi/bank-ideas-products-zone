# Copy to .env.local and fill in from your Supabase project settings (Project Settings > API).

# Safe to expose in the browser — used by the app to read data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — used solely by scripts/seed.ts.
# Never prefix with NEXT_PUBLIC_, never commit it, never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=
